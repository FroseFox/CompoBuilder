# Copiez ce fichier en ".env" (à la racine du projet) et remplissez les
# deux valeurs avec celles de votre projet Supabase :
# Dashboard Supabase > votre projet > Project Settings > API

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Ces deux valeurs sont conçues pour être publiques (elles finiront dans le
# code JavaScript envoyé au navigateur) : c'est normal et sans danger tant
# que les policies RLS de vos tables Supabase sont correctement configurées
# (voir le README, section "Sécurité : pourquoi c'est sans danger").
